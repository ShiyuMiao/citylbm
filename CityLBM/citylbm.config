# CityLBM 配置文件
# 请根据您的环境修改以下配置

[FluidX3D]
# FluidX3D 源码根目录（包含 FluidX3D.sln 或 Makefile）
# Windows 示例：D:\FluidX3D
# Linux/Mac 示例：/home/user/FluidX3D
InstallPath = D:\FluidX3D

[Simulation]
# 默认模拟参数
DefaultTimeSteps = 5000
DefaultSaveInterval = 500
DefaultViscosity = 1.5e-5

[AIJCaseE]
# CityLBM v0.3.0 release-gated validation preset.
# Formal validation must use official z=2 m probes only.
Enabled = true
Condition = ac
WindDirection = N
WindVectorX = 0
WindVectorY = -1
WindVectorZ = 0
ScaleFactor = 250
Uref = 3.928296
Zref = 15.9
ValidationHeight = 2
ProbeCase = ac
ProbeWindDirection = N
ExpectedProbeCount = 80
GeometryPath = docs\experiments\casee\official_data\BD_caseE.stl
ApproachFlowPath = docs\experiments\casee\official_data\AF_caseE.csv
ReferenceProbePath = docs\experiments\casee\official_data\RS_caseE.csv
LandformPath = docs\experiments\casee\official_data\LF_caseE.xls
FormalSamplingMode = raw_trilinear
DiagnosticSamplingModes = nearest_valid,fluid_weighted,vertical_valid_above,z_plus_half
ProbeProtocolRiskAudit = true
ZPlusHalfAllowedAsFormalResult = false

[AIJCaseEExperimental]
# These are experiment switches, not default accuracy models.
FullPlaneDigitalFilterInlet = false
NearWallAudit = false
RoughWallAudit = false
EffectiveGroundAudit = false
AllowZPlusHalfAsFormalResult = false

[Output]
# 工作目录（用于存储 Case 文件）
# 留空则使用系统临时目录
WorkingDirectory = 

[MSBuild]
# Visual Studio 安装路径（可选，用于自动查找 MSBuild）
# 留空则自动检测
VisualStudioPath = 
